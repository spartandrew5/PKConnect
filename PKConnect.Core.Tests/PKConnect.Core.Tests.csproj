<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PKConnect.Core.Tests</RootNamespace>

    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Saves the format tests read Pokémon out of. -->
    <Content Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.1.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />

    <Reference Include="../PKVault.Core/PKHeX.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKConnect.Core\PKConnect.Core.csproj" />
  </ItemGroup>

</Project>