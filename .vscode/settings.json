{
  "search.exclude": {
    "**/*.svg": true,
    "**/pokeapi/api-data": true,
    "**/pokeapi/sprites": true,
    "**/generated": true,
    "**/dist": true,
    "**/bin": true,
    "**/obj": true,
    "**/wwwroot": true,
    "**/tmp": true
  },
  "cssVariables.lookupFiles": ["**/*.css"],
  "cssVariables.languages": ["css"],
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  }
}